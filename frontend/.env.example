# Use the in-memory demo dataset instead of the FastAPI backend
VITE_USE_MOCK=false

# Backend origin used by the Vite dev proxy (defaults to http://localhost:8000)
VITE_PROXY_TARGET=http://localhost:8000

# Optional: browser-facing API base URL (defaults to /api).
# In production, set this to the deployed API, for example:
# VITE_API_URL=https://api.example.com/api
# VITE_API_URL=/api

# Optional: override where relative /uploads images are loaded from.
# Defaults to the origin of VITE_API_URL, or the current origin when unset.
# VITE_ASSET_URL=https://cdn.example.com
