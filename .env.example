# Database
POSTGRES_USER=foodlens
POSTGRES_PASSWORD=foodlens
POSTGRES_DB=foodlens
# Used by SQLAlchemy/Alembic. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://foodlens:foodlens@db:5432/foodlens

# Image classifiers (Hugging Face Hub models)
HF_MODEL_ID=nateraw/food
# Second engine for couscous and mloukhiya; CLIP arbitrates against Food-101.
REGIONAL_ENABLED=true
REGIONAL_MODEL_ID=mansourismatic/tunisian-food-classifier
CLIP_MODEL_ID=openai/clip-vit-base-patch32

# LLM enrichment layer. Groq is the default provider. Any OpenAI-compatible
# endpoint can be used instead through LLM_BASE_URL.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Uploads (must match the 5 MB limit enforced by the frontend)
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads
ANALYZE_RATE_LIMIT_PER_MINUTE=10

# Production only: number of Gunicorn/Uvicorn workers.
WEB_CONCURRENCY=1

# Optional host ports; change these if 8000/5173 are already in use.
API_PORT=8000
WEB_PORT=5173

# Frontend: false calls the real API, true serves local mock analyses.
VITE_USE_MOCK=false

# Production compose only: browser-facing API URL baked into the frontend build.
# Change the port if API_PORT is not 8000, or use your public API URL when deployed.
# VITE_API_URL=http://localhost:8000/api
