# Database
POSTGRES_USER=foodlens
POSTGRES_PASSWORD=foodlens
POSTGRES_DB=foodlens
# Used by SQLAlchemy/Alembic. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://foodlens:foodlens@db:5432/foodlens

# Image classifier (Hugging Face Hub model, Food-101)
HF_MODEL_ID=nateraw/food

# Optional LLM enrichment layer. Any OpenAI-compatible endpoint can be used
# through LLM_BASE_URL (for example a local server or a self-hosted model).
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Uploads (must match the 5 MB limit enforced by the frontend)
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads

# Optional host ports; change these if 8000/5173 are already in use.
API_PORT=8000
WEB_PORT=5173

# Frontend: false calls the real API, true serves local mock analyses.
VITE_USE_MOCK=false
