# Database
POSTGRES_USER=foodlens
POSTGRES_PASSWORD=foodlens
POSTGRES_DB=foodlens
# Used by SQLAlchemy/Alembic. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://foodlens:foodlens@db:5432/foodlens

# Image classifier (Hugging Face Hub model, Food-101)
HF_MODEL_ID=nateraw/food

# Optional LLM enrichment layer
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads
